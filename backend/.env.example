# Model provider keys. Fill in at least one; providers without a key are
# skipped automatically when the model catalog is built.

# OpenRouter: hundreds of models behind one key. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint: vLLM, Ollama, LM Studio, llama.cpp server.
# The base URL decides whether this provider is active; the key is optional
# because local servers usually don't need one.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

